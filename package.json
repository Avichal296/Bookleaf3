{
  "name": "bookleaf-author-royalty-hub",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "turbo run dev --filter=@bookleaf/server",
    "dev:web": "turbo run dev --filter=@bookleaf/client",
    "build": "turbo run build",
    "db:generate": "turbo run prisma:generate --filter=@bookleaf/server",
    "db:migrate": "turbo run prisma:migrate --filter=@bookleaf/server",
    "db:seed": "turbo run prisma:seed --filter=@bookleaf/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.7.3"
  },
  "packageManager": "npm@10.8.2"
}
